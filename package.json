{
  "name": "cargopulse-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CargoPulse — Enterprise Logistics Operations & 5-Leg Freight Audit Platform",
  "scripts": {
    "start:api": "npm run start:dev --prefix apps/api",
    "start:web": "npm start --prefix apps/web",
    "test:api": "npm test --prefix apps/api",
    "test:web": "npm test --prefix apps/web",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test:api && npm run test:web && npm run test:e2e",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0"
  }
}
